// Nested loops with a function call in the inner body.
fn cell(r, c) { return (r * 31 + c * 17) % 101; }
fn run() {
    let sum = 0;
    for (let r = 0; r < 300; r = r + 1) {
        for (let c = 0; c < 300; c = c + 1) {
            sum = sum + cell(r, c);
        }
    }
    return sum;
}
print(run());
